# ---- Provider selection -------------------------------------------------
# gotracker = temporary GO Tracker upstream (development)
# metrolinx = official Metrolinx Open Data API (once credentials arrive)
TRANSIT_PROVIDER=gotracker

# ---- GO Tracker temporary provider --------------------------------------
GOTRACKER_BASE_URL=https://www.gotracker.ca/GOTracker/web/GODataAPIProxy.svc
# The upstream rejects requests without a same-site Referer header.
GOTRACKER_REFERER=https://www.gotracker.ca/GOTracker/en/index.aspx
GOTRACKER_REFRESH_SECONDS=15

# ---- Metrolinx official provider (future) -------------------------------
METROLINX_API_BASE_URL=https://api.openmetrolinx.com/OpenDataAPI
METROLINX_API_KEY=

# ---- Caching / polling --------------------------------------------------
LIVE_VEHICLE_REFRESH_SECONDS=15
STATION_REFRESH_SECONDS=20
UPSTREAM_TIMEOUT_MS=10000

# ---- Dev tools ----------------------------------------------------------
# /dev/transit and /dev/card-styles are always available when running locally
# (npm run dev). In production they are hidden unless this is exactly "true".
# Keep it false: hosting platforms read this file to pre-fill settings, and
# "true" here would publish the diagnostics pages on the live site.
ENABLE_DEV_TRANSIT_PAGE=false

# ---- Map ----------------------------------------------------------------
# Optional MapLibre style overrides. Defaults are keyless VersaTiles styles.
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=

# ---- GO Tracker mobile proxy (platform boards) --------------------------
# Supplies platform numbers for trains and buses. No key required.
GOTRACKER_LIVE_BASE_URL=https://www.gotracker.ca/gotracker/mobile/proxy/web
